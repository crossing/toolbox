# Anchored patterns only. A bare, unanchored name matches at ANY depth: freeagent-cli's
# .gitignore had `freeagent-cli` on line 1, which silently ignored
# .agents/skills/freeagent-cli/SKILL.md so it never reached version control -- and in
# this monorepo the same pattern would have swallowed all of tools/freeagent/.
# nix/checks.nix fails the build if anything under tools/ becomes ignored.

/result
/result-*
/tools/*/result
/tools/*/result-*

.direnv/
node_modules/

# Go build output. Never add a bare binary name here -- see above.
/bin/

# Python tooling scratch under tools/op-mcp (uv.lock IS tracked).
/tools/op-mcp/.venv/
/tools/op-mcp/src/op_mcp/__pycache__/
/tools/op-mcp/tests/__pycache__/
