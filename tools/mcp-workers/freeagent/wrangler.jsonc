{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeagent-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FreeagentReadMCP", "FreeagentRwMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "FREEAGENT_READ_MCP", "class_name": "FreeagentReadMCP" },
      { "name": "FREEAGENT_RW_MCP", "class_name": "FreeagentRwMCP" }
    ]
  },
  "kv_namespaces": [
    // id is filled in per-account: `wrangler kv namespace create freeagent-mcp-oauth`
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "observability": { "enabled": true }
}
