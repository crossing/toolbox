{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "freeagent-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Served at https://freeagent-mcp.xing.works — the custom domain is attached
  // once via the Workers Domains API (PUT /accounts/:id/workers/domains), not
  // via a routes entry here, because the deploy token deliberately has no
  // zone-scoped permissions. workers.dev stays off so the OAuth issuer/resource
  // URL is single and stable.
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    // Optional peer of the agents package; only its AI-chat path needs it.
    "ai": "../shared/src/ai-stub.ts"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FreeagentReadMCP", "FreeagentRwMCP"]
    },
    // v2: single endpoint — write access is scope-gated at consent, not a
    // separate connector, so the duplicate rw DO class goes away.
    {
      "tag": "v2",
      "renamed_classes": [{ "from": "FreeagentReadMCP", "to": "FreeagentMCP" }],
      "deleted_classes": ["FreeagentRwMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FREEAGENT_MCP", "class_name": "FreeagentMCP" }]
  },
  "kv_namespaces": [
    // "freeagent-mcp-oauth" namespace; recreate with
    // `wrangler kv namespace create freeagent-mcp-oauth` if it is ever lost
    // (grants are invalidated, connectors just need reconnecting).
    { "binding": "OAUTH_KV", "id": "99314c0bcbb84fbeb93d9c65f010cb5c" }
  ],
  "observability": { "enabled": true }
}
