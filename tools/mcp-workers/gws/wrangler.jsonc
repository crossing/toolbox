{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gws-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Served at https://gws-mcp.xing.works — custom domain attached once via the
  // Workers Domains API (see freeagent/wrangler.jsonc for the rationale).
  "workers_dev": false,
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    // Optional peer of the agents package; only its AI-chat path needs it.
    "ai": "../shared/src/ai-stub.ts"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GwsMCP"]
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "GWS_MCP", "class_name": "GwsMCP" }]
  },
  "kv_namespaces": [
    // "gws-mcp-oauth" namespace; recreate with
    // `wrangler kv namespace create gws-mcp-oauth` if it is ever lost
    // (grants are invalidated, connectors just need reconnecting).
    { "binding": "OAUTH_KV", "id": "3cf1e8b6122e48cc8533d8b8ce10baaf" }
  ],
  "observability": { "enabled": true }
}
