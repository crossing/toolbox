{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whatsapp-spike",
  "main": "src/spike.ts",
  "compatibility_date": "2026-08-01",
  // nodejs_compat gives Buffer/crypto/events that Baileys and its deps reach
  // for; the WASM bridge instantiates at module top-level (startup), which
  // workerd permits — the spike proves whether that actually holds.
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    // Baileys hardcodes `import WebSocket from 'ws'`, which throws in
    // workerd. Point it at a shim over workerd's native outbound WebSocket.
    "ws": "./src/ws-shim.ts"
  },
  "workers_dev": false
}
