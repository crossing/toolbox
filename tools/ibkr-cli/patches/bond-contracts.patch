diff --git a/src/ibkr_cli/ib_service.py b/src/ibkr_cli/ib_service.py
index db8aed4..101874e 100644
--- a/src/ibkr_cli/ib_service.py
+++ b/src/ibkr_cli/ib_service.py
@@ -679,6 +679,181 @@ def get_executions(
 
 _SUPPORTED_ORDER_TYPES = ("MKT", "LMT", "STP", "STP LMT", "TRAIL")
 
+# Security types a caller may request. STK keeps the historical ticker-based lookup; every
+# other type must name the instrument by conId or ISIN, because IBKR does not resolve those
+# by ticker (a gilt's "symbol" matches every gilt).
+SUPPORTED_SEC_TYPES = ("STK", "BOND")
+_IDENTIFIER_REQUIRED_SEC_TYPES = ("BOND",)
+_ISIN_PATTERN = re.compile(r"^[A-Z]{2}[A-Z0-9]{9}[0-9]$")
+
+
+def _isin_check_digit_ok(isin: str) -> bool:
+    # ISO 6166: expand letters to two digits (A=10 .. Z=35), then Luhn over the whole string.
+    digits = "".join(str(int(char, 36)) for char in isin)
+    total = 0
+    for index, char in enumerate(reversed(digits)):
+        value = int(char)
+        if index % 2 == 1:
+            value *= 2
+            if value > 9:
+                value -= 9
+        total += value
+    return total % 10 == 0
+
+
+def normalize_contract_request(
+    sec_type: Optional[str] = "STK",
+    con_id: Optional[int] = None,
+    isin: Optional[str] = None,
+) -> Tuple[str, Optional[int], Optional[str]]:
+    """Validate and normalise the instrument selector before any Gateway round trip."""
+    normalized_sec_type = (sec_type or "STK").strip().upper()
+    if normalized_sec_type not in SUPPORTED_SEC_TYPES:
+        types = ", ".join(SUPPORTED_SEC_TYPES)
+        raise ValueError(f"Unsupported security type '{sec_type}'. Use one of: {types}.")
+    if con_id is not None and con_id <= 0:
+        raise ValueError("--conid must be a positive integer.")
+    normalized_isin: Optional[str] = None
+    if isin is not None:
+        normalized_isin = isin.strip().upper()
+        if not _ISIN_PATTERN.match(normalized_isin) or not _isin_check_digit_ok(normalized_isin):
+            raise ValueError(f"'{isin}' is not a valid ISIN.")
+    if normalized_sec_type in _IDENTIFIER_REQUIRED_SEC_TYPES and con_id is None and normalized_isin is None:
+        raise ValueError(
+            f"{normalized_sec_type} contracts must be identified with --conid or --isin; "
+            "IBKR does not resolve them by ticker."
+        )
+    return normalized_sec_type, con_id, normalized_isin
+
+
+def _build_contract(
+    symbol: str,
+    exchange: str,
+    currency: str,
+    sec_type: Optional[str] = "STK",
+    con_id: Optional[int] = None,
+    isin: Optional[str] = None,
+) -> object:
+    try:
+        from ib_async import Contract, Stock
+    except ModuleNotFoundError as exc:
+        raise RuntimeError(
+            "ib_async is not installed. Reinstall the project with Python 3.10+ to enable IBKR API commands."
+        ) from exc
+
+    normalized_sec_type, con_id, isin = normalize_contract_request(sec_type, con_id, isin)
+    if normalized_sec_type == "STK" and con_id is None and isin is None:
+        # Unchanged historical behaviour: a stock resolved by ticker.
+        return Stock(symbol=symbol.upper(), exchange=exchange, currency=currency)
+
+    # Identifier-based lookup. The positional symbol is deliberately left out: a caller's
+    # label must never widen or redirect which instrument IBKR resolves.
+    fields: Dict[str, object] = dict(secType=normalized_sec_type, currency=currency)
+    if con_id is not None:
+        fields["conId"] = con_id
+    if isin is not None:
+        fields["secIdType"] = "ISIN"
+        fields["secId"] = isin
+    else:
+        # IBKR finds no ISIN match once an exchange is named (even SMART), so the exchange
+        # is only sent with a conId and is otherwise applied after resolution.
+        fields["exchange"] = exchange
+    return Contract(**fields)
+
+
+def _describe_contract_request(
+    symbol: str,
+    sec_type: Optional[str] = "STK",
+    con_id: Optional[int] = None,
+    isin: Optional[str] = None,
+) -> str:
+    parts = []
+    if con_id is not None:
+        parts.append(f"conId {con_id}")
+    if isin:
+        parts.append(f"ISIN {isin.strip().upper()}")
+    if not parts:
+        return f"symbol '{symbol}'"
+    return f"{(sec_type or 'STK').upper()} " + " / ".join(parts)
+
+
+def _qualify_contract(
+    ib: object,
+    symbol: str,
+    exchange: str,
+    currency: str,
+    sec_type: Optional[str] = "STK",
+    con_id: Optional[int] = None,
+    isin: Optional[str] = None,
+) -> Tuple[object, Dict[str, object]]:
+    """Resolve the requested instrument to exactly one contract.
+
+    Returns the contract and extra payload fields describing it. A stock named by ticker
+    is qualified exactly as before and adds no fields. An identifier-based request is
+    resolved from its contract details, because IBKR returns bonds with no symbol or
+    local symbol: the description (for example "UKT 0 1/8 01/31/28") and ISIN are the
+    only human-checkable proof of which instrument a preview is for.
+    """
+    normalized_sec_type, con_id, isin = normalize_contract_request(sec_type, con_id, isin)
+    contract = _build_contract(symbol, exchange, currency, sec_type=normalized_sec_type, con_id=con_id, isin=isin)
+    description = _describe_contract_request(symbol, normalized_sec_type, con_id, isin)
+
+    if normalized_sec_type == "STK" and con_id is None and isin is None:
+        qualified = ib.qualifyContracts(contract)
+        # ib_async returns [None] (not []) for an unknown or ambiguous contract.
+        resolved = qualified[0] if qualified else None
+        if resolved is None or not getattr(resolved, "conId", None):
+            raise RuntimeError(f"Unable to qualify contract for {description}.")
+        return resolved, {}
+
+    details_list = ib.reqContractDetails(contract) or []
+    matches = [
+        details for details in details_list
+        if getattr(getattr(details, "contract", None), "secType", None) == normalized_sec_type
+    ]
+    if not matches:
+        other_types = sorted({getattr(d.contract, "secType", "?") for d in details_list if d.contract})
+        if other_types:
+            raise RuntimeError(
+                f"IBKR resolved a {', '.join(other_types)} contract, not the requested {description}."
+            )
+        raise RuntimeError(f"Unable to qualify contract for {description}.")
+    if len(matches) > 1:
+        con_ids = ", ".join(str(details.contract.conId) for details in matches)
+        raise RuntimeError(f"Ambiguous contract for {description}: conIds {con_ids}. Pass --conid.")
+
+    details = matches[0]
+    resolved = details.contract
+    if not getattr(resolved, "conId", None):
+        raise RuntimeError(f"Unable to qualify contract for {description}.")
+    if con_id is not None and resolved.conId != con_id:
+        raise RuntimeError(f"IBKR resolved conId {resolved.conId}, not the requested {description}.")
+
+    resolved_isins = [
+        tag.value for tag in (getattr(details, "secIdList", None) or [])
+        if getattr(tag, "tag", "") == "ISIN" and getattr(tag, "value", "")
+    ]
+    if isin is not None and resolved_isins and isin not in resolved_isins:
+        raise RuntimeError(
+            f"IBKR resolved ISIN {', '.join(resolved_isins)}, not the requested {description}."
+        )
+
+    valid_exchanges = [value for value in (getattr(details, "validExchanges", "") or "").split(",") if value]
+    if exchange:
+        if valid_exchanges and exchange not in valid_exchanges:
+            raise RuntimeError(
+                f"Exchange '{exchange}' is not valid for {description}; "
+                f"use one of: {', '.join(valid_exchanges)}."
+            )
+        resolved.exchange = exchange
+
+    instrument = {
+        "description": getattr(details, "descAppend", "") or getattr(details, "longName", "") or None,
+        "isin": resolved_isins[0] if resolved_isins else isin,
+        "valid_exchanges": valid_exchanges,
+    }
+    return resolved, instrument
+
 
