+def _execution_con_id(contract: object) -> Optional[int]:
+    value = getattr(contract, "conId", None)
+    if isinstance(value, bool):
+        return None
+    try:
+        con_id = int(value)
+    except (TypeError, ValueError):
+        return None
+    return con_id if con_id > 0 else None
+
