+def resolve_what_to_show(sec_type: Optional[str], what_to_show: Optional[str]) -> str:
+    """TRADES stays the default for stocks and bonds; a currency pair has no TRADES history,
+    so CASH defaults to MIDPOINT and refuses TRADES rather than returning no rows."""
+    is_fx = (sec_type or "STK").strip().upper() == "CASH"
+    if what_to_show is None or not what_to_show.strip():
