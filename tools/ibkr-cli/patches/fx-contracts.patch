+def normalize_fx_request(
+    symbol: str,
+    exchange: str,
+    currency: str,
+    con_id: Optional[int] = None,
+) -> Tuple[Optional[str], str, str]:
+    """Split a CASH pair such as GBP.USD into (base, quote) and pin the exchange to IDEALPRO.
+
+    IBKR lists each pair once: GBP.USD exists and USD.GBP does not, so converting USD into
+    GBP is a BUY of GBP.USD. The quantity is in the base currency and the price is quote
+    currency per unit of base. Without a pair the instrument must be named by --conid.
+    """
+    pair = (symbol or "").strip().upper()
+    match = _FX_PAIR_PATTERN.match(pair)
+    quote_currency = (currency or "").strip().upper()
+    base: Optional[str] = None
+    if match:
+        base, quote = match.group(1), match.group(2)
+        if base == quote:
+            raise ValueError(f"'{symbol}' is not a currency pair.")
+        if quote_currency and quote_currency != quote:
+            raise ValueError(
+                f"--currency {quote_currency} does not match the quote currency of {pair}; pass --currency {quote}."
+            )
+        quote_currency = quote
+    elif con_id is None:
+        raise ValueError(
+            f"CASH contracts must be named by currency pair, for example GBP.USD, or by --conid; got '{symbol}'."
+        )
+    if not quote_currency:
+        raise ValueError("CASH contracts need a quote currency.")
+    normalized_exchange = (exchange or "").strip().upper()
+    if normalized_exchange in ("", "SMART"):
+        normalized_exchange = _FX_EXCHANGE
+    if normalized_exchange != _FX_EXCHANGE:
+        raise ValueError(f"CASH contracts trade only on {_FX_EXCHANGE}, not '{exchange}'.")
+    return base, quote_currency, normalized_exchange
+
+
+def validate_contract_selector(
+    symbol: str,
+    exchange: str,
+    currency: str,
+    sec_type: Optional[str] = "STK",
+    con_id: Optional[int] = None,
+    isin: Optional[str] = None,
+) -> None:
+    """Reject a malformed selector, including a malformed CASH pair, before any Gateway session."""
+    normalized_sec_type, con_id, _ = normalize_contract_request(sec_type, con_id, isin)
+    if normalized_sec_type == "CASH":
+        normalize_fx_request(symbol, exchange, currency, con_id)
+
