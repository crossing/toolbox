+    normalized = what_to_show.strip().upper()
+    if is_fx and normalized not in _FX_WHAT_TO_SHOW:
+        raise ValueError(
+            f"CASH pairs have no {normalized} history; use --what-to-show {', '.join(_FX_WHAT_TO_SHOW)}."
+        )
